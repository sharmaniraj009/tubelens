{
  "manifest_version": 3,
  "name": "TubeLens – Creator SEO, Clips & Thumbnails",
  "version": "0.3.0",
  "description": "SEO score, video stats, a clip finder for the most replayed moments, keyword ideas and a thumbnail maker for YouTube creators.",
  "permissions": ["storage", "unlimitedStorage", "clipboardWrite"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://suggestqueries.google.com/*",
    "https://www.googleapis.com/youtube/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_popup": "src/popup.html", "default_title": "TubeLens" },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["lib/seo.js", "lib/youtube.js", "lib/clips.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
